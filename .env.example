OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TAVILY_API_KEY=
WEB_SEARCH_MAX_QUERIES=3
WEB_SEARCH_MAX_PAGES=8
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Keep development/local until explicit Supabase activation.
ENVIRONMENT=development
AUTH_MODE=local
DATABASE_URL=sqlite:///./data/career_ops.db
# Staged Session pooler URI; configure_supabase.py applies the empty schema and selects it.
SUPABASE_DATABASE_URL=
DATABASE_SCHEMA=career_ops
# Required in production; download this project's CA certificate from Supabase Database Settings.
DATABASE_SSL_ROOT_CERT=./data/supabase/prod-ca-2021.crt
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Elevated backend-only key for Auth identity deletion. Never use as the publishable key.
SUPABASE_SECRET_KEY=
SEARCH_DAILY_USER_LIMIT=5
SEARCH_DAILY_GLOBAL_LIMIT=20
MODEL_DAILY_GLOBAL_LIMIT=90
WEB_DAILY_GLOBAL_LIMIT=60
SEARCH_TIMEOUT_SECONDS=600
ARTIFACT_DIR=./data/artifacts
SOURCES_FILE=./data/sources.json
# Optional override; default is <project>/data/geonames/geography.sqlite
# GEONAMES_DB=
